{
  "expo": {
    "name": "Realtime Groundwater",
    "slug": "realtime-groundwater",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cgwblogo.png",
    "scheme": "realtime-groundwater",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone for voice input in the chatbot.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to show groundwater predictions for your area."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cgwblogo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/cgwblogo.png"
      
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashImage.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show groundwater predictions for your area."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
